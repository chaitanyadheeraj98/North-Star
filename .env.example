# Adaptive LLM Router - environment
# Copy to .env and edit if any default is wrong for your machine.
# Everything here has a working default; .env is optional.

# --- Backend -----------------------------------------------------------------

# Where the Dockerised backend reaches the Pi bridge running on your host.
# Docker Desktop resolves host.docker.internal automatically; on Linux the
# host-gateway entry in docker-compose.yml makes the same name work.
PI_BRIDGE_URL=http://host.docker.internal:31415

# How long to wait for an analysis. A real model call on a long task can take a
# while, and failing at 30s would be worse than waiting.
PI_TIMEOUT_SECONDS=180

APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host ports. Both bind to loopback only. Change them if something else on this
# machine already owns 3000 or 8000 - the two containers talk to each other over
# the internal Docker network regardless.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Pi bridge (host process) ------------------------------------------------

# Loopback only. Anything that can reach this port can spend your subscription
# quota, so it must not be exposed to the LAN.
PI_BRIDGE_HOST=127.0.0.1
PI_BRIDGE_PORT=31415

# --- Analyzer selection (the model that CLASSIFIES your tasks) ---------------
#
# Explicit on purpose. An earlier version picked "the first authenticated
# provider", which silently classified tasks with whichever provider happened to
# resolve first - a different model from the one interactive Pi was signed in to.
# The analyzer drives every routing decision downstream, so it is chosen, never
# inferred. If the configured model is unavailable the bridge reports it and
# stops; it does not substitute another one.
#
# Run `pi --list-models` for the exact ids.
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.5

# Pi thinking level for the analyzer itself: minimal | low | medium | high | xhigh
# This is Pi's vocabulary for the CLASSIFIER, and is separate from the effort
# level the router recommends for the model that will do the actual work.
# Classification is a small structured judgement, so low is the default.
PI_THINKING_LEVEL=low

# Only set this if the bridge cannot find backend/config/task_families.yaml,
# for example when running it from outside the repository.
# TASK_FAMILIES_PATH=D:/My Websites/North Star/backend/config/task_families.yaml
